# Keycard configuration
# Your Keycard zone URL, e.g. https://your-zone-id.keycard.cloud
KEYCARD_ISSUER=

# Client credentials for this MCP server, created in the Keycard Console
# (required with the default client_secret credential type)
KEYCARD_CLIENT_ID=
KEYCARD_CLIENT_SECRET=

# Credential type: "client_secret" (default) or "web_identity"
# With web_identity, the server authenticates with a private key JWT instead
# of a client secret; see the README for details.
# KEYCARD_CREDENTIAL_TYPE=client_secret
# KEYCARD_WEB_IDENTITY_KEY_STORAGE_DIR=./server_keys

# Server configuration
# Public URL of this MCP server (as registered in Keycard)
MCP_SERVER_URL=http://localhost:8000
PORT=8000

# Resource identifier of the Google API as registered in Keycard.
# Must match the Keycard resource exactly. Default: https://www.googleapis.com
# GOOGLE_API_RESOURCE=https://www.googleapis.com
